<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The window theme only paints the background before Compose takes over; all app styling lives
      in the Compose Material 3 theme.

      The parent is an AppCompat theme because MainActivity is an AppCompatActivity - which is what
      applies the per-app locale below Android 13 - and AppCompat refuses to run under a plain
      platform theme. Nothing else about the appearance changes: there is still no action bar, and
      the only attribute set is the window background.
    -->
    <style name="Theme.GriffKeeper" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!--
      Cold-start (Android 12+) splash screen: a flat navy window shown before any activity code has
      run, replaced by the Compose splash screen (see presentation/splash/SplashScreen.kt) once the
      first frame draws. `postSplashScreenTheme` is what hands control back to the real app theme.
    -->
    <style name="Theme.GriffKeeper.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/griff_splash_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_griff_emblem_splash_anim</item>
        <item name="windowSplashScreenAnimationDuration">750</item>
        <item name="postSplashScreenTheme">@style/Theme.GriffKeeper</item>
    </style>
</resources>
