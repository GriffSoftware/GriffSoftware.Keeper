<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GriffKeeper" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.GriffKeeper.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/griff_splash_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_griff_emblem_splash_anim</item>
        <item name="windowSplashScreenAnimationDuration">750</item>
        <item name="postSplashScreenTheme">@style/Theme.GriffKeeper</item>
    </style>
</resources>
