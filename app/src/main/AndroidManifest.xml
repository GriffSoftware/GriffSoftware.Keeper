<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".app.GriffKeeperApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GriffKeeper">

        <!--
            Persistence of the chosen language below Android 13.

            From Android 13 the platform stores the per-app locale itself, and the choice survives a
            reinstall. Below that, AppCompat keeps it - but only if this flag is set, and this
            declaration is the whole of the opt-in. The service is never started and is disabled on
            purpose: it exists only to carry the meta-data, which is why this needs no permission of
            any kind. Without it the app would have to keep its own copy of the language, and there
            would be two sources of truth for what is already platform state.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.GriffKeeper"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Reminder deep links. The scheme is private to the app - the notification sets the
                package explicitly - and exists so the notification can name a destination without
                the infrastructure layer having to know which activity hosts it.

                One filter per host, with one attribute per data tag: a single filter listing both
                hosts would match the cross product of every scheme and host it mentions.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="griff" />
                <data android:host="subscription" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="griff" />
                <data android:host="obligation" />
            </intent-filter>
        </activity>
    </application>

</manifest>
