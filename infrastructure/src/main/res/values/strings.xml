<?xml version="1.0" encoding="utf-8"?>
<!-- English is the base locale; Polish lives in values-pl. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
    <!-- Notification channel -->
    <string name="reminder_channel_name">Reminders</string>
    <string name="reminder_channel_description">Notifications about upcoming payments, renewals and insurance about to expire.</string>

    <!-- Insurance expiry -->
    <string name="reminder_insurance_subtext_tomorrow">Insurance expires tomorrow</string>
    <string name="reminder_insurance_text">The policy is valid until %1$s.</string>
    <string name="reminder_insurance_text_tomorrow">The policy ends on %1$s.</string>

    <!-- Payment due -->
    <string name="reminder_payment_subtext_tomorrow">Payment due tomorrow</string>
    <string name="reminder_payment_text">%1$s • due %2$s</string>
    <string name="reminder_payment_text_tomorrow">To pay: %1$s</string>

    <!-- Subscription renewal -->
    <string name="reminder_renewal_subtext_tomorrow">Renews tomorrow</string>
    <string name="reminder_renewal_text">%1$s • next payment %2$s</string>
    <string name="reminder_renewal_text_yearly">%1$s • yearly subscription</string>
    <string name="reminder_renewal_text_tomorrow">Scheduled payment: %1$s</string>

    <!--
        Date pattern rather than copy: CLDR orders the day and the month differently per language
        ("September 28" against "28 września"), and no localized FormatStyle drops the year.
    -->
    <string name="reminder_date_day_month_pattern">MMMM d</string>

    <plurals name="reminder_insurance_subtext_in_days">
        <item quantity="one">Insurance expires in %1$d day</item>
        <item quantity="other">Insurance expires in %1$d days</item>
    </plurals>

    <plurals name="reminder_payment_subtext_in_days">
        <item quantity="one">Payment due in %1$d day</item>
        <item quantity="other">Payment due in %1$d days</item>
    </plurals>

    <plurals name="reminder_renewal_subtext_in_days">
        <item quantity="one">Renews in %1$d day</item>
        <item quantity="other">Renews in %1$d days</item>
    </plurals>
</resources>
